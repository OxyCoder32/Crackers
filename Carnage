        local l = math.acos(math.clamp(r:Dot(t.PreLook), -1, 1))

        if math.acos(math.clamp(t.WroteLook:Dot(t.PreLook), -1, 1)) > 0.002 then
            if l < U * 0.5 then
                t.Over = ((t.Over or 0)) + 1
            else
                t.Over = 0
            end
            if ((t.Over or 0)) >= 8 and type(mousemoverel) == 'function' then
                t.Mouse = true
            end
        end
    end

    t.WroteLook, t.PreLook = nil, nil

    if t.Mouse then
        local r, l = p:WorldToViewportPoint(u)

        if l and r.Z > 0 then
            local l = y.VP(p) / 2
            local N = math.clamp(k / 100, 0, 0.95)
            local i = 0.12 + ((1 - N)) * 0.55

            if U.SnapNow then
                i = 0.9
            end

            pcall(mousemoverel, ((r.X - l.X)) * i, ((r.Y - l.Y)) * i)
        end

        return
    end

    local P = PE()
    local G = u - P

    if G.Magnitude < 0.05 then
        return
    end

    G = G.Unit

    local E = math.asin(math.clamp(G.Y, -1, 1))
    local h = math.rad(78)

    if math.abs(E) > h then
        local r = Vector3.new(G.X, 0, G.Z)

        if r.Magnitude < 0.0001 then
            return
        end

        r = r.Unit

        local U = E >= 0 and 1 or -1

        G = ((r * math.cos(h) + Vector3.new(0, U * math.sin(h), 0))).Unit
    end

    local T = p.CFrame.Position
    local b = CFrame.new(T, T + G)
    local a = math.clamp(k / 100, 0, 0.95)
    local m = 3 + ((1 - a)) * 27
    local A = math.clamp(1 - math.exp(-m * math.min(r, 0.1)), 0, 1)

    if U.SnapNow then
        A = 1
    end

    local j = p.CFrame:Lerp(b, A)

    t.PreLook = p.CFrame.LookVector
    p.CFrame = CFrame.new(j.Position, j.Position + j.LookVector)
    t.WroteLook = p.CFrame.LookVector
end

